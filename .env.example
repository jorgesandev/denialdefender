# ─── AMD MI300X / vLLM ──────────────────────────────────────────────────────
# Both models run co-resident on a single MI300X via split GPU memory allocation.
# Forward these ports locally via SSH tunnel:
#   ssh -L 8000:localhost:8000 -L 8001:localhost:8001 root@<droplet-ip>

# Qwen3-32B — language model, port 8000, gpu-memory-utilization 0.65
VLLM_LLM_URL=http://localhost:8000/v1

# Qwen2.5-VL-7B-Instruct — vision model, port 8001, gpu-memory-utilization 0.25
VLLM_VL_URL=http://localhost:8001/v1

# ─── PostgreSQL + pgvector ──────────────────────────────────────────────────
# Used for clinical literature retrieval (PubMed embeddings).
# Not required for the demo — retrieval.py falls back to mock data if unset.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=denialdefender
PG_URL=postgresql://postgres:password@localhost:5432/denialdefender

# ─── Frontend ───────────────────────────────────────────────────────────────
# Copy to frontend/.env.local (Next.js only loads NEXT_PUBLIC_ vars from there).
# Do NOT put this in the root .env — the browser won't see it.

NEXT_PUBLIC_API_URL=http://localhost:9000

# ─── HF Space deployment (hf_space/app.py) ──────────────────────────────────
# Set NGROK_URL as a Secret in your Hugging Face Space settings (not in code).
# Expose the FastAPI backend publicly before pushing to the Space:
#   pip install pyngrok
#   ngrok http 9000
# Copy the https://xxxx.ngrok.app URL here, then add it as a Space secret.

NGROK_URL=https://xxxx.ngrok.app
